<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RangerFinder.MainPage">

    <Grid RowDefinitions="*, 2*, Auto" Padding="10">
        <!-- Sensor Legend / Current Values -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="10">
                <!-- Ultrasonic 1 -->
                <Frame BackgroundColor="#ffebee" Padding="10" CornerRadius="8">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Color="Red" WidthRequest="20" HeightRequest="20" CornerRadius="10"/>
                        <Label Text="Ultrasonic 1:" VerticalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="{Binding CurrentData.Ultrasonic1, TargetNullValue='0', StringFormat='{0} m'}" VerticalOptions="Center" TextColor="Black"/>
                    </HorizontalStackLayout>
                </Frame>
                <!-- Ultrasonic 2 -->
                <Frame BackgroundColor="#e3f2fd" Padding="10" CornerRadius="8">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Color="Blue" WidthRequest="20" HeightRequest="20" CornerRadius="10"/>
                        <Label Text="Ultrasonic 2:" VerticalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="{Binding CurrentData.Ultrasonic2, TargetNullValue='0', StringFormat='{0} m'}" VerticalOptions="Center" TextColor="Black"/>
                    </HorizontalStackLayout>
                </Frame>
                <!-- Lidar 1 -->
                <Frame BackgroundColor="#e8f5e9" Padding="10" CornerRadius="8">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Color="Green" WidthRequest="20" HeightRequest="20" CornerRadius="10"/>
                        <Label Text="Lidar 1:" VerticalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="{Binding CurrentData.Lidar1, TargetNullValue='0', StringFormat='{0} m'}" VerticalOptions="Center" TextColor="Black"/>
                    </HorizontalStackLayout>
                </Frame>
                <!-- Lidar 2 -->
                <Frame BackgroundColor="#fff3e0" Padding="10" CornerRadius="8">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Color="Orange" WidthRequest="20" HeightRequest="20" CornerRadius="10"/>
                        <Label Text="Lidar 2:" VerticalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="{Binding CurrentData.Lidar2, TargetNullValue='0', StringFormat='{0} m'}" VerticalOptions="Center" TextColor="Black"/>
                    </HorizontalStackLayout>
                </Frame>
                <!-- Obstacle -->
                <Frame BackgroundColor="#f3e5f5" Padding="10" CornerRadius="8">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView Color="Purple" WidthRequest="20" HeightRequest="20" CornerRadius="10"/>
                        <Label Text="Obstacle:" VerticalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="{Binding CurrentData.Obstacle, TargetNullValue='0', StringFormat='{0} m'}" VerticalOptions="Center" TextColor="Black"/>
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Chart Area -->
        <Frame Grid.Row="1" BorderColor="Gray" HasShadow="False" CornerRadius="8" Padding="0" Margin="0,10">
            <GraphicsView x:Name="ChartGraphicsView" />
        </Frame>

        <!-- Bottom Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="5" ColumnSpacing="15">
            <Button Grid.Column="0" Text="|&lt;---&gt;| Průměry" Command="{Binding OpenDetailsCommand}" VerticalOptions="Center" CornerRadius="8" />
            
            <Button Grid.Column="1" 
                    Text="⚙️" 
                    FontSize="24"
                    WidthRequest="50" 
                    HeightRequest="50" 
                    CornerRadius="25"
                    Padding="0"
                    BackgroundColor="#e0e0e0"
                    TextColor="Black"
                    Command="{Binding OpenSettingsCommand}" />
        </Grid>
    </Grid>

</ContentPage>
