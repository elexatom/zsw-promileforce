<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RangerFinder.ViewModels"
             xmlns:models="clr-namespace:RangerFinder.Core.Models;assembly=RangerFinder.Core"
             x:Class="RangerFinder.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{StaticResource Background}">
             
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <!-- Header Section -->
            <VerticalStackLayout Spacing="4" Padding="16,0,0,0">
                <BoxView WidthRequest="2" Color="{StaticResource Primary}" 
                         HorizontalOptions="Start" VerticalOptions="Fill" Margin="-16,0,0,0" />
                <Label Text="ADVANCED TELEMETRY" FontSize="24" FontAttributes="Bold" 
                       CharacterSpacing="1" TextColor="{StaticResource OnSurface}" />
                <Label Text="SESS_ID: 4492-XRAY" FontSize="10" CharacterSpacing="2"
                       TextColor="{StaticResource Outline}" TextTransform="Uppercase" />
            </VerticalStackLayout>
            
            <!-- Chart Area -->
            <Frame BackgroundColor="{StaticResource SurfaceContainerLow}" HasShadow="False"
                   CornerRadius="8" Padding="24" BorderColor="Transparent">
                <VerticalStackLayout Spacing="16">
                    <Grid>
                        <VerticalStackLayout HorizontalOptions="Start">
                            <Label Text="SPATIAL ANALYSIS" FontSize="12" FontAttributes="Bold" 
                                   CharacterSpacing="2" TextColor="{StaticResource OnSurfaceVariant}" />
                            <Label Text="Real-time distance delta" FontSize="9" CharacterSpacing="2"
                                   TextColor="{StaticResource Outline}" TextTransform="Uppercase" />
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Actual GraphicsView -->
                    <Frame BorderColor="{StaticResource OutlineVariant}" BackgroundColor="Transparent" 
                           HasShadow="False" CornerRadius="4" Padding="0" HeightRequest="200">
                        <GraphicsView x:Name="ChartGraphicsView" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Sensor Readings -->
            <VerticalStackLayout Spacing="16">
                <!-- VL53LDK ToF -->
                <Frame BackgroundColor="{StaticResource SurfaceContainerHighest}" 
                       CornerRadius="8" Padding="20" BorderColor="Transparent">
                    <Grid>
                        <BoxView Color="{StaticResource Primary}" WidthRequest="4" 
                                 HorizontalOptions="Start" VerticalOptions="Fill" Margin="-20,-20,0,-20"/>
                        <VerticalStackLayout Spacing="12">
                            <Grid>
                                <Label Text="PRIMARY TOF" FontSize="10" CharacterSpacing="2" 
                                       TextColor="{StaticResource Outline}" HorizontalOptions="Start" />
                            </Grid>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                                <Label Text="{Binding CurrentData.Lidar1, TargetNullValue='0000', StringFormat='{0:F3}'}" 
                                       FontSize="32" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                <Label Text="M" FontSize="12" TextColor="{StaticResource Outline}" VerticalOptions="End" Margin="0,0,0,6"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Waveshare Laser -->
                <Frame BackgroundColor="{StaticResource SurfaceContainerHighest}" 
                       CornerRadius="8" Padding="20" BorderColor="Transparent">
                    <Grid>
                        <BoxView Color="{StaticResource Secondary}" WidthRequest="4" 
                                 HorizontalOptions="Start" VerticalOptions="Fill" Margin="-20,-20,0,-20"/>
                        <VerticalStackLayout Spacing="12">
                            <Grid>
                                <Label Text="SECONDARY TOF" FontSize="10" CharacterSpacing="2" 
                                       TextColor="{StaticResource Outline}" HorizontalOptions="Start" />
                            </Grid>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                                <Label Text="{Binding CurrentData.Lidar2, TargetNullValue='0.00', StringFormat='{0:F2}'}" 
                                       FontSize="32" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                <Label Text="M" FontSize="12" TextColor="{StaticResource Outline}" VerticalOptions="End" Margin="0,0,0,6"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- HC-SR04 -->
                <Frame BackgroundColor="{StaticResource SurfaceContainerHighest}" 
                       CornerRadius="8" Padding="20" BorderColor="Transparent">
                    <Grid>
                        <BoxView Color="{StaticResource Tertiary}" WidthRequest="4" 
                                 HorizontalOptions="Start" VerticalOptions="Fill" Margin="-20,-20,0,-20"/>
                        <VerticalStackLayout Spacing="12">
                            <Grid>
                                <Label Text="PRIMARY ULTRASONIC" FontSize="10" CharacterSpacing="2" 
                                       TextColor="{StaticResource Outline}" HorizontalOptions="Start" />
                            </Grid>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                                <Label Text="{Binding CurrentData.Ultrasonic1, TargetNullValue='0.0', StringFormat='{0:F1}'}" 
                                       FontSize="32" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                <Label Text="M" FontSize="12" TextColor="{StaticResource Outline}" VerticalOptions="End" Margin="0,0,0,6"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
                
                <!-- HC-SR04 Secondary -->
                <Frame BackgroundColor="{StaticResource SurfaceContainerHighest}" 
                       CornerRadius="8" Padding="20" BorderColor="Transparent">
                    <Grid>
                        <BoxView Color="{StaticResource Magenta}" WidthRequest="4" 
                                 HorizontalOptions="Start" VerticalOptions="Fill" Margin="-20,-20,0,-20"/>
                        <VerticalStackLayout Spacing="12">
                            <Grid>
                                <Label Text="SECONDARY ULTRASONIC" FontSize="10" CharacterSpacing="2" 
                                       TextColor="{StaticResource Outline}" HorizontalOptions="Start" />
                            </Grid>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                                <Label Text="{Binding CurrentData.Ultrasonic2, TargetNullValue='0.0', StringFormat='{0:F1}'}" 
                                       FontSize="32" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                <Label Text="M" FontSize="12" TextColor="{StaticResource Outline}" VerticalOptions="End" Margin="0,0,0,6"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Obstacle Sensor -->
                <Frame BackgroundColor="{StaticResource SurfaceContainerHighest}" 
                       CornerRadius="8" Padding="20" BorderColor="Transparent">
                    <Grid>
                        <BoxView Color="{StaticResource Error}" WidthRequest="4" 
                                 HorizontalOptions="Start" VerticalOptions="Fill" Margin="-20,-20,0,-20"/>
                        <VerticalStackLayout Spacing="12">
                            <Grid>
                                <Label Text="OBSTACLE SENSOR" FontSize="10" CharacterSpacing="2" 
                                       TextColor="{StaticResource Outline}" HorizontalOptions="Start" />
                            </Grid>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                                <Label Text="{Binding CurrentData.Obstacle, TargetNullValue='0.0', StringFormat='{0:F1}'}" 
                                       FontSize="32" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                                <Label Text="M" FontSize="12" TextColor="{StaticResource Outline}" VerticalOptions="End" Margin="0,0,0,6"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </VerticalStackLayout>
            
            <!-- Terminal -->
            <Frame BackgroundColor="{StaticResource SurfaceContainerLow}" 
                   HasShadow="False" CornerRadius="8" Padding="0" BorderColor="Transparent" HeightRequest="200">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" BackgroundColor="{StaticResource SurfaceContainerHighest}" Padding="16,8">
                        <Label Text="SYSTEM LOG &amp; RAW DEBUG" FontSize="10" FontAttributes="Bold" 
                               CharacterSpacing="2" TextColor="{StaticResource OnSurface}" VerticalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="8" VerticalOptions="Center">
                            <BoxView Color="{StaticResource Error}" WidthRequest="8" HeightRequest="8" CornerRadius="4" />
                            <BoxView Color="{StaticResource Secondary}" WidthRequest="8" HeightRequest="8" CornerRadius="4" />
                        </HorizontalStackLayout>
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding ConsoleLogs}" Margin="16">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontFamily="Consolas"
                                       FontSize="10" TextColor="{StaticResource OnSurfaceVariant}" Margin="0,2" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
