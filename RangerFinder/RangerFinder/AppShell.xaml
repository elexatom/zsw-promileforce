<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:RangerFinder"
       x:Class="RangerFinder.AppShell"
       Shell.TabBarBackgroundColor="{StaticResource Background}"
       Shell.TabBarTitleColor="{StaticResource Outline}"
       Shell.TabBarUnselectedColor="{StaticResource OutlineVariant}">

    <TabBar>
        <Tab Title="SIMPLE" 
             Icon="{FontImage FontFamily=OpenSansRegular, Glyph='📏', Color={StaticResource Outline}}">
            <ShellContent ContentTemplate="{DataTemplate local:DetailsPage}" />
        </Tab>
        <Tab Title="ADVANCED" 
             Icon="{FontImage FontFamily=OpenSansRegular, Glyph='📈', Color={StaticResource Primary}}">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="SETTINGS" 
             Icon="{FontImage FontFamily=OpenSansRegular, Glyph='⚙️', Color={StaticResource Outline}}">
            <ShellContent ContentTemplate="{DataTemplate local:DebugPage}" />
        </Tab>
    </TabBar>

</Shell>
