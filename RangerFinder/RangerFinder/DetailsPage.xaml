<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RangerFinder.ViewModels"
             x:Class="RangerFinder.DetailsPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{StaticResource Background}">
    
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            
            <!-- System Status -->
            <Frame BackgroundColor="{StaticResource SurfaceContainerLow}" 
                   HasShadow="False" CornerRadius="8" Padding="32" BorderColor="Transparent">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="SYSTEM STATUS" FontSize="10" CharacterSpacing="2"
                           TextColor="{StaticResource Outline}" HorizontalOptions="Center" />
                    
                    <Frame BackgroundColor="Transparent" BorderColor="{StaticResource Tertiary}" 
                           CornerRadius="48" HeightRequest="96" WidthRequest="96" Padding="0"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="✓" FontSize="48" TextColor="{StaticResource Tertiary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    
                    <Label Text="{Binding ConnectionStatus, TargetNullValue='CLEAR'}" 
                           FontSize="48" FontAttributes="Bold" TextColor="{StaticResource Tertiary}"
                           HorizontalOptions="Center" />
                    
                    <Label Text="All systems operational" FontSize="12" CharacterSpacing="1"
                           TextColor="{StaticResource OutlineVariant}" HorizontalOptions="Center"
                           TextTransform="Uppercase" />
                </VerticalStackLayout>
            </Frame>

            <!-- MIN DISTANCE (Lidar) -->
            <Frame BackgroundColor="{StaticResource SurfaceContainerLow}" 
                   HasShadow="False" CornerRadius="8" Padding="0" BorderColor="Transparent">
                <VerticalStackLayout>
                    <Grid Padding="24,12" BackgroundColor="{StaticResource SurfaceContainerHighest}">
                        <Label Text="TOF ALPHA" FontSize="10" CharacterSpacing="2" 
                               TextColor="{StaticResource Primary}" HorizontalOptions="Start" />
                        <Label Text="SENSOR: LIDAR 1" FontSize="9" 
                               TextColor="{StaticResource Outline}" HorizontalOptions="End" />
                    </Grid>
                    <VerticalStackLayout Padding="32" Spacing="24">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding CurrentData.Lidar1, TargetNullValue='0.00', StringFormat='{0:F2}'}" 
                                   FontSize="60" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                            <Label Text="m" FontSize="24" TextColor="{StaticResource OutlineVariant}" 
                                   VerticalOptions="End" Margin="0,0,0,12" />
                        </HorizontalStackLayout>
                        <ProgressBar Progress="{Binding CurrentData.Lidar1, TargetNullValue='0'}" 
                                     ProgressColor="{StaticResource Primary}" />
                        <Grid>
                            <Label Text="0.00m" FontSize="9" TextColor="{StaticResource OutlineVariant}" HorizontalOptions="Start"/>
                            <Label Text="5.00m" FontSize="9" TextColor="{StaticResource OutlineVariant}" HorizontalOptions="End"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
            
            <!-- MAX DISTANCE (Ultrasonic) -->
            <Frame BackgroundColor="{StaticResource SurfaceContainerLow}" 
                   HasShadow="False" CornerRadius="8" Padding="0" BorderColor="Transparent">
                <VerticalStackLayout>
                    <Grid Padding="24,12" BackgroundColor="{StaticResource SurfaceContainerHighest}">
                        <Label Text="US BETA" FontSize="10" CharacterSpacing="2" 
                               TextColor="{StaticResource Secondary}" HorizontalOptions="Start" />
                        <Label Text="SENSOR: ULTRASONIC 1" FontSize="9" 
                               TextColor="{StaticResource Outline}" HorizontalOptions="End" />
                    </Grid>
                    <VerticalStackLayout Padding="32" Spacing="24">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{Binding CurrentData.Ultrasonic1, TargetNullValue='0.00', StringFormat='{0:F2}'}" 
                                   FontSize="60" FontAttributes="Bold" TextColor="{StaticResource OnSurface}" />
                            <Label Text="m" FontSize="24" TextColor="{StaticResource OutlineVariant}" 
                                   VerticalOptions="End" Margin="0,0,0,12" />
                        </HorizontalStackLayout>
                        <ProgressBar Progress="{Binding CurrentData.Ultrasonic1, TargetNullValue='0'}" 
                                     ProgressColor="{StaticResource Secondary}" />
                        <Grid>
                            <Label Text="0.00m" FontSize="9" TextColor="{StaticResource OutlineVariant}" HorizontalOptions="Start"/>
                            <Label Text="5.00m" FontSize="9" TextColor="{StaticResource OutlineVariant}" HorizontalOptions="End"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
