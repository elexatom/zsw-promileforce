<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RangerFinder.ViewModels"
             x:Class="RangerFinder.DetailsPage"
             x:DataType="vm:MainViewModel"
             Title="Details">
    
    <VerticalStackLayout Spacing="20" Padding="20">
        <Label Text="Obstacle Information" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
        
        <Frame BackgroundColor="#f3e5f5" Padding="20" CornerRadius="12" HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="Average Measurement" FontSize="18" TextColor="Gray" HorizontalOptions="Center"/>
                <Label Text="{Binding AverageObstacle, TargetNullValue='0', StringFormat='{0:F2} m'}" 
                       FontSize="36" FontAttributes="Bold" TextColor="Purple" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>
        
        <Label Text="Average / Historic Data: Check Chart" 
               FontSize="12" TextColor="Gray" HorizontalOptions="Center" Margin="0,20,0,0"/>

        <Button Text="Go Back" Command="{Binding GoBackCommand}" HorizontalOptions="Center" Margin="0,50,0,0"/>
    </VerticalStackLayout>
</ContentPage>
